---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import GoogleAnalytics from './GoogleAnalytics.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogType?: string;
  noHeader?: boolean;
  noFooter?: boolean;
}
const {
  title,
  description,
  canonical,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  noHeader = false,
  noFooter = false,
} = Astro.props;

const siteUrl = import.meta.env.SITE_URL || 'https://weedspots.io';
const gsc = import.meta.env.GSC_VERIFICATION;
const fullOg = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script is:inline>
      // Apply theme before paint to prevent FOUC.
      // - No saved pref → follow OS (live-updates on prefers-color-scheme change).
      // - Saved 'light'/'dark' → explicit user choice, OS changes are ignored.
      // The toggle button flips between light and dark and persists the choice.
      (function () {
        var root = document.documentElement;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}

        function applyResolved() {
          var isDark = saved === 'dark' || (saved !== 'light' && mq.matches);
          root.classList.toggle('dark', isDark);
          root.classList.toggle('light', !isDark);
        }
        applyResolved();

        window.__weedspotsTheme = {
          cycle: function () {
            // Flip to the opposite of the currently-rendered theme.
            var next = root.classList.contains('dark') ? 'light' : 'dark';
            saved = next;
            try { localStorage.setItem('theme', next); } catch (e) {}
            applyResolved();
          },
        };

        try {
          mq.addEventListener('change', function () {
            // Only track OS changes while the user has no explicit pref.
            if (saved !== 'light' && saved !== 'dark') applyResolved();
          });
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-US" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="weedspots" />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={fullOg} />
    <meta name="twitter:card" content="summary_large_image" />
    {gsc && <meta name="google-site-verification" content={gsc} />}
    <slot name="head" />
    <GoogleAnalytics />
  </head>
  <body class="min-h-screen flex flex-col">
    {!noHeader && <Header />}
    <main class="flex-1"><slot /></main>
    {!noFooter && <Footer />}
  </body>
</html>
