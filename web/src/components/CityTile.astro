---
import type { CityAggregate } from '../lib/types';
interface Props { city: CityAggregate }
const { city } = Astro.props;
---
<a href={`/${city.stateCitySlug}/`}
   class="block bg-white rounded-lg border border-ink-100 p-5 hover:shadow-card-hover transition">
  <div class="text-lg font-semibold text-ink-900">{city.cityName}</div>
  <div class="text-sm text-ink-500">{city.state}</div>
  <div class="mt-2 text-sm text-brand-600 font-medium">{city.count.toLocaleString()} listings</div>
</a>
