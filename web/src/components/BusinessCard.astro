---
import Rating from './Rating.astro';
import type { Business } from '../lib/types';

interface Props { business: Business; sponsored?: boolean }
const { business: b, sponsored = false } = Astro.props;

const openNow = b.openingHours?.openNow;
---
<a href={`/listing/${b.slug}/`}
   class="group block bg-ink-50 rounded-2xl overflow-hidden ring-1 ring-black/5 dark:ring-white/10 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 hover:ring-brand-500/30 active:scale-[0.99] transition-[transform,box-shadow] duration-200 ease-[var(--ease-out-strong)] focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500">
  <div class="relative aspect-[4/3] w-full bg-ink-100 overflow-hidden">
    {b.coverPhoto ? (
      <img src={b.coverPhoto} alt={b.name} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 ease-[var(--ease-out-strong)] group-hover:scale-[1.03]" width="800" height="600" />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-brand-50 to-ink-100 dark:from-ink-100 dark:to-ink-200" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-brand-500/70 dark:text-brand-400/60">
          <path d="M12 2c1 4 4 6 8 6-1 5-5 9-10 9-1-4-4-6-8-6 1-5 5-9 10-9Z" />
          <path d="M12 2c0 8-4 13-10 15" />
        </svg>
      </div>
    )}
    {openNow !== null && openNow !== undefined && (
      <span class={`absolute top-3 right-3 text-xs font-medium px-2 py-0.5 rounded-full backdrop-blur-sm ${openNow ? 'bg-brand-500/95 text-white' : 'bg-ink-900/80 text-ink-50'}`}>
        {openNow ? 'Open' : 'Closed'}
      </span>
    )}
    {sponsored && (
      <span class="absolute top-3 left-3 text-[10px] font-semibold uppercase tracking-[0.08em] bg-ink-50/95 text-ink-700 rounded-full px-2 py-0.5 ring-1 ring-black/5 backdrop-blur-sm">Sponsored</span>
    )}
  </div>
  <div class="p-4">
    <h3 class="text-[15px] font-semibold text-ink-900 group-hover:text-brand-600 line-clamp-1 transition-colors duration-150">{b.name}</h3>
    <div class="text-sm text-ink-500 mt-0.5 line-clamp-1">{b.category} · {b.city}, {b.state}</div>
    <div class="mt-2">
      <Rating value={b.rating || 0} count={b.reviewCount || 0} />
    </div>
  </div>
</a>
