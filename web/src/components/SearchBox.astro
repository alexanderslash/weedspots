---
interface Props { variant?: 'full' | 'header'; placeholder?: string }
const { variant = 'full', placeholder = 'Search businesses, cities, categories...' } = Astro.props;
---
<div class="w-full max-w-xl">
  <input
    id="ws-search-input"
    type="search"
    placeholder={placeholder}
    class="w-full rounded-full bg-ink-50 px-5 py-3 text-base text-ink-900 placeholder:text-ink-400 ring-1 ring-black/5 dark:ring-white/10 shadow-card focus:outline-none focus:ring-2 focus:ring-brand-500 transition-[box-shadow] duration-150 ease-out"
    autocomplete="off"
  />
  <div id="ws-search-results" class="mt-3 grid grid-cols-1 gap-2"></div>
</div>

<script is:inline>
  (function() {
    const input = document.getElementById('ws-search-input');
    const results = document.getElementById('ws-search-results');
    if (!input || !results) return;
    let index = null;
    let loading = false;

    async function loadIndex() {
      if (index || loading) return;
      loading = true;
      try {
        const res = await fetch('/search-index.json');
        index = await res.json();
      } finally { loading = false; }
    }

    function render(matches) {
      results.innerHTML = '';
      for (const m of matches) {
        const a = document.createElement('a');
        a.href = '/listing/' + m.slug + '/';
        a.className = 'block bg-ink-50 rounded-2xl p-4 ring-1 ring-black/5 dark:ring-white/10 hover:ring-brand-500/40 hover:-translate-y-0.5 active:scale-[0.99] transition-[transform,box-shadow] duration-150 ease-out';
        a.innerHTML =
          '<div class="font-semibold text-ink-900">' + m.name + '</div>' +
          '<div class="text-sm text-ink-500">' + m.category + ' · ' + m.city + ', ' + m.state + '</div>';
        results.appendChild(a);
      }
      if (matches.length === 0) {
        results.innerHTML = '<p class="text-ink-500 text-sm">No matches.</p>';
      }
    }

    function runSearch() {
      const q = input.value.trim().toLowerCase();
      if (!q || !index) { results.innerHTML = ''; return; }
      const out = [];
      for (const row of index) {
        const hay = (row.name + ' ' + row.city + ' ' + row.category).toLowerCase();
        if (hay.includes(q)) out.push(row);
        if (out.length >= 50) break;
      }
      render(out);
    }

    input.addEventListener('focus', loadIndex, { once: true });
    input.addEventListener('input', runSearch);

    // Pre-fill from ?q=
    const params = new URLSearchParams(location.search);
    const q = params.get('q');
    if (q) {
      input.value = q;
      loadIndex().then(runSearch);
    }
  })();
</script>
