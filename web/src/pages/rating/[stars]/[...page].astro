---
import Layout from '../../../components/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BusinessGrid from '../../../components/BusinessGrid.astro';
import Pagination from '../../../components/Pagination.astro';
import SchemaJsonLd from '../../../components/SchemaJsonLd.astro';
import { getAllData } from '../../../lib/data';
import { rankSort } from '../../../lib/ranking';
import { paginate, paginationData } from '../../../lib/pagination';
import { breadcrumbSchema } from '../../../lib/schema-org';
import { LISTINGS_PER_PAGE } from '../../../lib/constants';
import type { Business } from '../../../lib/types';

export async function getStaticPaths() {
  const TIERS = [
    { slug: '5-star', min: 4.9, label: '5-star' },
    { slug: '4-star', min: 3.9, label: '4-star and above' },
  ] as const;

  const { businesses } = getAllData();
  const paths: Array<{
    params: { stars: string; page: string | undefined };
    props: { tier: (typeof TIERS)[number]; pageItems: Business[]; currentPage: number; totalPages: number };
  }> = [];

  for (const tier of TIERS) {
    const list = businesses
      .filter(b => (b.rating || 0) >= tier.min)
      .sort(rankSort);
    const pages = paginate(list, LISTINGS_PER_PAGE);
    pages.forEach((pageItems, i) => {
      paths.push({
        params: { stars: tier.slug, page: i === 0 ? undefined : `page/${i + 1}` },
        props: { tier, pageItems, currentPage: i + 1, totalPages: pages.length },
      });
    });
  }
  return paths;
}

interface Props {
  tier: { slug: string; min: number; label: string };
  pageItems: Business[];
  currentPage: number;
  totalPages: number;
}
const { tier, pageItems, currentPage, totalPages } = Astro.props;

const siteUrl = import.meta.env.SITE_URL || 'https://weedspots.io';
const baseUrl = `/rating/${tier.slug}/`;
const canonical = `${siteUrl}${currentPage === 1 ? baseUrl : `${baseUrl}page/${currentPage}/`}`;
const title = `${tier.label} cannabis businesses${currentPage > 1 ? ` — Page ${currentPage}` : ''} | weedspots`;
const description = `Browse ${tier.label.toLowerCase()} cannabis businesses across the United States.`;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: tier.label },
];
const pag = paginationData(currentPage, totalPages, baseUrl);
---
<Layout title={title} description={description} canonical={canonical}>
  <SchemaJsonLd slot="head" json={breadcrumbSchema(crumbs)} />
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4 text-3xl md:text-4xl font-semibold tracking-tight">{tier.label}</h1>
    <p class="mt-2 text-ink-600">Page {currentPage} of {totalPages}</p>
  </div>
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 pb-16">
    <BusinessGrid businesses={pageItems} />
    <Pagination data={pag} />
  </div>
</Layout>
