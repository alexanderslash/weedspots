---
import Layout from '../../components/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchBox from '../../components/SearchBox.astro';
import SchemaJsonLd from '../../components/SchemaJsonLd.astro';
import { breadcrumbSchema } from '../../lib/schema-org';

const siteUrl = import.meta.env.SITE_URL || 'https://weedspots.io';
const canonical = `${siteUrl}/search/`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Search' }];
---
<Layout title="Search | weedspots" description="Search cannabis businesses by name, city, or category." canonical={canonical}>
  <SchemaJsonLd slot="head" json={breadcrumbSchema(crumbs)} />
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4 text-3xl md:text-4xl font-semibold tracking-tight">Search</h1>
    <div class="mt-8"><SearchBox /></div>
  </div>
</Layout>
