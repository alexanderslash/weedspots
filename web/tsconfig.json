{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.astro", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
